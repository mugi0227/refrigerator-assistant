{
  "name": "refrigerator-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first, hands-free refrigerator assistant with Gemma 4 and barcode scanning",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "npm run check && npm test",
    "deploy": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run",
    "ios:prepare": "node scripts/prepare-ios.mjs"
  },
  "devDependencies": {
    "@huggingface/transformers": "4.3.1",
    "onnxruntime-web": "1.30.0",
    "wrangler": "4.148.0"
  },
  "overrides": {
    "sharp": "0.35.5"
  }
}
